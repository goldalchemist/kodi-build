    <import addon="xbmc.python" version="3.0.0"/>
    <import addon="plugin.video.umbrella" version="6.8.02"/>
    <import addon="script.module.cocoscrapers" version="1.0.45"/>
    <import addon="plugin.video.the-loop" version="1.3"/>
    <import addon="script.trakt" version="3.9.0"/>
    <import addon="skin.arctic.horizon.2" version="0.8.29"/>
    <import addon="plugin.video.themoviedb.helper" version="6.22.7"/>
    <import addon="script.andy.control" version="1.0.0"/>
  </requires>
  <extension point="xbmc.python.module" library="lib"/>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Meta add-on: its dependencies are the build</summary>
    <description lang="en_GB">Meta add-on: its dependencies are the build</description>
    <platform>all</platform>
  </extension>
</addon>
